  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:dir": "electron-builder --dir",
    "build:nsis": "electron-builder --win nsis --x64 --publish never",
    "dist": "electron-builder --win --x64 --publish never",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "release": "electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.ngshp.ngpb.launcher",
    "productName": "NG PB Launcher",
    "copyright": "Copyright © 2026 NGPB Team - v53.6 Auto Update System - 77.3MB - Fast Boot 0.8s - Draggable Rapi + No Download - Build #96 Auto Update Success",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "Launcher/**/*",
      "launcher/**/*",
      "security/**/*",
      "src/**/*",
      "assets/**/*",
      "installer.nsh",
      "package.json",
      "version.json"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": ["**/*"]
      },
      {
        "from": "Launcher/",
        "to": "Launcher/",
        "filter": ["**/*"]
      },
      {
        "from": "version.json",
        "to": "version.json"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "NGPB_Launcher_Setup_${version}_Auto_Update_Draggable_Rapi.exe",
      "publisherName": "NGPB Team",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "shortcutName": "NG PB Launcher",
      "uninstallDisplayName": "NG PB Launcher v${version} - v53.6 Auto Update - Draggable Rapi - No Download Needed! - 77.3 MB",
      "displayLanguageSelector": false,
      "include": "installer.nsh",
      "warningsAsErrors": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ngshp",
        "repo": "ngpb",
        "private": false,
        "releaseType": "release"
      }
    ],
    "compression": "maximum",
    "asar": true,
    "npmRebuild": true,
    "buildDependenciesFromSource": false,
    "asarUnpack": [
      "**/node_modules/electron-updater/**/*",
      "**/node_modules/electron-log/**/*",
      "Launcher/**/*",
      "version.json"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "electron-log": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

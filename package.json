{
  "name": "ngpb-launcher-enterprise-pro",
  "version": "1.0.3",
  "description": "NGPB Launcher Enterprise Pro - Discord RPC + AutoPatcher + Signed x64 + Security v3",
  "main": "main.js",
  "homepage": "./",
  "author": "NGPB Team <support@ngpb.id>",
  "license": "MIT",
  "private": true,
  "build": {
    "appId": "id.ngpb.launcher.enterprise",
    "productName": "NGPB Launcher Enterprise",
    "copyright": "Copyright © 2026 NGPB Launcher",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "certificateSubjectName": "NGPB Team",
      "verifyUpdateCodeSignature": false,
      "signingHashAlgorithms": [
        "sha256"
      ],
      "publisherName": "NGPB Team"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "NGPB_Launcher_Setup_${version}_Enterprise.exe",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "NGPB_Launcher_Portable_${version}_Enterprise.exe"
    }
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:win": "electron-builder --win --x64 --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-log": "^5.0.1",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.3",
    "electron-builder": "^24.9.1"
  }
}

// package.json patch - ADD THESE DEPS
{
  "dependencies": {
    "electron-updater": "^6.1.7",
    "discord-rpc": "^4.0.1",
    "electron-log": "^5.0.1"
  },
  "devDependencies": {
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "id.ngpb.launcher",
    "productName": "NGPB Launcher",
    "directories": { "output": "dist" },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "certificateSubjectName": "NGPB Team",
      "verifyUpdateCodeSignature": false,
      "signingHashAlgorithms": ["sha256"],
      "publisherName": "Nusantara Game Point Blank"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      { "provider": "generic", "url": "https://ngpb.id/updates/" },
      { "provider": "github", "owner": "ngshp", "repo": "ngpb" }
    ]
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  }
}

// QUICK INSTALL:
// npm install electron-updater discord-rpc electron-log --save
// npm install electron-builder --save-dev

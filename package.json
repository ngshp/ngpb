{
  "name": "ngpb-launcher-enterprise",
  "version": "1.53.6",
  "description": "NGPB Launcher Enterprise v53.7 FIX - Valid Semver + Cache Fix + Draggable Rapi 1200x700 - Auto Update - Final",
  "main": "main.js",
  "author": "NGPB Team <admin@ngshp.com> - v53.7 FIX",
  "copyright": "Copyright © 2026 NGPB Team - v53.7 FIX - 77.3MB - Valid Semver 1.53.6",
  "homepage": "https://github.com/ngshp/ngpb",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngshp/ngpb.git"
  },
  "license": "MIT",
  "keywords": ["ngpb","point blank","launcher","electron","enterprise","auto-update","draggable","rapi","fix"],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:dir": "electron-builder --dir",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.ngshp.ngpb.launcher",
    "productName": "NG PB Launcher",
    "copyright": "Copyright © 2026 NGPB Team - v53.7 FIX - Valid Semver 1.53.6",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "Launcher/**/*",
      "launcher/**/*",
      "assets/**/*",
      "installer.nsh",
      "package.json",
      "version.json"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": ["**/*"]
      },
      {
        "from": "Launcher/",
        "to": "Launcher/",
        "filter": ["**/*"]
      },
      {
        "from": "version.json",
        "to": "version.json"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "NGPB_Launcher_Setup_${version}_FIX_Draggable_Rapi.exe",
      "publisherName": "NGPB Team",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "shortcutName": "NG PB Launcher",
      "uninstallDisplayName": "NG PB Launcher v${version} - v53.7 FIX - Valid Semver - 77.3 MB",
      "displayLanguageSelector": false,
      "include": "installer.nsh",
      "warningsAsErrors": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ngshp",
        "repo": "ngpb",
        "private": false,
        "releaseType": "release"
      }
    ],
    "compression": "maximum",
    "asar": true,
    "npmRebuild": true,
    "asarUnpack": [
      "**/node_modules/electron-updater/**/*",
      "**/node_modules/electron-log/**/*",
      "Launcher/**/*",
      "version.json"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "electron-log": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

{
  "name": "ngpb-launcher-enterprise",
  "version": "1.0.45",
  "description": "NGPB Launcher Enterprise v45 ULTIMATE - AutoUpdate + AntiRDP/VM + AntiDebug + HWID Lock + WPE PRO Killer",
  "main": "main.js",
  "author": "NGPB Team <admin@ngshp.com>",
  "homepage": "https://github.com/ngshp/ngpb",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.ngshp.ngpb.launcher",
    "productName": "NGPB Launcher Enterprise",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NGPB Launcher Enterprise"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ngshp",
        "repo": "ngpb",
        "private": false
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}

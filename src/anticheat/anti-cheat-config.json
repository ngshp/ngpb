  "mode": "aggressive",

  "blacklist_processes": [
    "WPE PRO.exe",
    "WPE Pro.exe",
    "wpepro.exe",
    "cheatengine-x86_64.exe",
    "cheatengine-i386.exe",
    "cheatengine.exe",
